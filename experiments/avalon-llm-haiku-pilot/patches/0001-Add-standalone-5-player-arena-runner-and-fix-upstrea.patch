+import asyncio
+
+import pytest
+
+pytest.importorskip("networkx")
+
+import src.arena.game as game  # noqa: E402
+from src.arena.events import EventLog  # noqa: E402
+from src.arena.seeding import deal  # noqa: E402
+
+from .conftest import make_cfg  # noqa: E402
+
+
+def search_cfg(base_seed):
+    seats = [{"agent": "search", "provider": "fake", "planner_num_rollout": 3, "planner_node_budget": 3}] + \
+            [{"agent": "llm", "provider": "fake"} for _ in range(4)]
+    return make_cfg(seats=seats, base_seed=base_seed, num_games=1, discussion=True)
+
+
+@pytest.mark.parametrize("base_seed", [7, 11])
+def test_search_planner_uses_its_own_seat(tmp_path, monkeypatch, base_seed):
+    r"""The planner must see the game from its own seat and role, in votes and in discussion.
+
+    Regression: the actor enumerator returned the lowest-numbered acting player, so in votes the
+    planner reasoned as Player 0 (or 1), and discussion used the quest leader's private information.
+    """
+    seen = []
+    base = game.AGENT_FINDER["search"]
+
+    class Recording(base):
+        async def initialize_game_info(self, player_list, env=None, **kwargs):
+            await super().initialize_game_info(player_list, env=env, **kwargs)
+            planner = self.action_planner
+            act, utter = planner.act, planner.produce_utterance
+
+            def recorded_act(information_set, actions):
+                seen.append(("act", self.id, self.role, information_set.self_player, information_set.self_role))
+                return act(information_set, actions)
+
+            def recorded_utterance(state):
+                seen.append(("speak", self.id, self.role, state.self_player, state.self_role))
+                return utter(state=state)
+
+            planner.act, planner.produce_utterance = recorded_act, recorded_utterance
+
+    monkeypatch.setitem(game.AGENT_FINDER, "search", Recording)
+    cfg = search_cfg(base_seed)
+    setup = deal(cfg, 0)
+    with EventLog(str(tmp_path / "g.jsonl"), run_id="t", game_idx=0) as log:
+        end = asyncio.run(game.play_game(setup, cfg, log))
+
+    assert end["status"] == "completed"
+    kinds = {k for k, *_ in seen}
+    assert kinds == {"act", "speak"}
+    for kind, seat, role, pov_seat, pov_role in seen:
+        assert (pov_seat, pov_role) == (seat, role), f"{kind}: planner at seat {seat} reasoned as seat {pov_seat}"
+    # the deal puts the search agent away from seat 0, so the old bug would have shown up
+    assert setup.seat_specs[0].agent != "search"
