+import importlib.util
+import os
+
+# load the engine module directly: importing src.server.tasks.avalon pulls in the full agent stack
+ENGINE_PATH = os.path.join(os.path.dirname(__file__), "..", "..", "src", "server", "tasks", "avalon", "engine.py")
+spec = importlib.util.spec_from_file_location("avalon_engine_under_test", ENGINE_PATH)
+engine = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(engine)
+
+
+def test_from_presets_does_not_share_state():
+    a = engine.AvalonGameEnvironment.from_presets(
+        {"num_players": 5, "quest_leader": 0, "role_names": ["Merlin", "Servant", "Servant", "Assassin", "Minion"]})
+    b = engine.AvalonGameEnvironment.from_presets(
+        {"num_players": 5, "quest_leader": 3, "role_names": ["Assassin", "Minion", "Merlin", "Servant", "Servant"]})
+    assert a.get_role(0)[1] == "Merlin" and b.get_role(0)[1] == "Assassin"
+    assert a.get_quest_leader() == 0 and b.get_quest_leader() == 3
+    assert a.get_assassin() == 3 and b.get_assassin() == 0
+    assert "roles" not in vars(engine.AvalonGameEnvironment)
+
+    a.choose_quest_team(frozenset({0, 1}), leader=0)
+    assert a.get_phase()[0] == 1 and b.get_phase()[0] == 0
+    assert a.quest_results is not b.quest_results
