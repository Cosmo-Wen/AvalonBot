+# 5-player Avalon arena. Every model call runs through Claude Code (`claude -p`) on your own login.
+#   python -m src.arena check --config configs/arena/avalon5.yaml
+#   python -m src.arena run   --config configs/arena/avalon5.yaml --run-dir results/arena/<run-id>
+# Add --fake to `run` to play offline with a scripted model (free; checks the install).
+# Re-running the same `run` command resumes: finished games are skipped, unfinished ones replayed with the same seed.
+
+num_players: 5
+seats:              # participants; with shuffle_seats they are permuted across seats per game
+  # model: Claude Code alias or full id. haiku stretches subscription usage furthest; sonnet/opus play better.
+  # planner_model (search/recon only) sets the model for the search agent's internal dialogue planner.
+  - {agent: search, provider: claude_cli, model: haiku}
+  - {agent: llm, provider: claude_cli, model: haiku}
+  - {agent: llm, provider: claude_cli, model: haiku}
+  - {agent: llm, provider: claude_cli, model: haiku}
+  - {agent: llm, provider: claude_cli, model: haiku}
+  # With a Claude API key (pip install 'anthropic>=2.0.0', export ANTHROPIC_API_KEY=...), a seat can use the API:
+  #   - {agent: llm, provider: anthropic, model: claude-opus-5-5, effort: medium}
+  # API model ids or the aliases haiku / sonnet / opus; `effort` is low|medium|high|xhigh|max (null to omit).
+roles: [Merlin, Servant, Servant, Assassin, Minion]
+
+num_games: 4
+base_seed: 0
+shuffle_roles: true
+shuffle_seats: true
+random_leader: true
+discussion: true
+
+concurrency: 1        # games played in parallel
+cli_max_parallel: 2   # concurrent `claude -p` processes across all games
+max_game_retries: 2   # replays of a game after an infrastructure failure
+llm_max_retries: 5    # retries per model call on timeouts / overload
+llm_timeout_s: 180
+backoff_base_s: 2
+backoff_max_s: 60
+# claude_bin: /path/to/claude   # only if `claude` is not on PATH
