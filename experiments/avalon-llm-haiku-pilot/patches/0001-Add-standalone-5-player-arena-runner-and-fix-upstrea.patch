+import asyncio
+import json
+import os
+from collections import Counter
+
+import pytest
+
+from src.arena.__main__ import summarize
+from src.arena.events import read_events
+from src.arena.runner import game_path, run
+
+from .conftest import make_cfg
+
+# plays real games (engine, agents, proxy, search planner) against the offline fake backend
+pytest.importorskip("networkx")
+
+
+def fake_cfg(**overrides):
+    # small search budget keeps the CPU-bound planner quick; the default (100) takes ~4s per decision
+    seats = [{"agent": "search", "provider": "fake", "name": "search0", "planner_num_rollout": 5, "planner_node_budget": 5}] + \
+            [{"agent": "llm", "provider": "fake", "name": f"llm{i}"} for i in range(4)]
+    return make_cfg(**{"seats": seats, "num_games": 2, "concurrency": 2, **overrides})
+
+
+def test_full_games_with_fake_backend(tmp_path, capsys):
+    run_dir = str(tmp_path / "run")
+    ends = asyncio.run(run(fake_cfg(), run_dir, log_fn=lambda *_: None))
+    assert [e["data"]["status"] for e in ends] == ["completed", "completed"]
+    for i in range(2):
+        events = read_events(game_path(run_dir, i))
+        types = Counter(e["type"] for e in events)
+        assert events[0]["type"] == "game_start" and events[-1]["type"] == "game_end"
+        assert types["team_proposed"] >= 3 and types["quest_result"] >= 3 and types["beliefs"] == 1
+        sources = Counter(e["data"]["source"] for e in events if e["type"] == "llm_call")
+        assert sources["seat"] > 0 and sources["planner"] > 0  # search planner routed through the backend
+        assert {e["data"]["model"] for e in events if e["type"] == "llm_call"} == {"fake"}
+    summary = summarize(run_dir)
+    assert summary["statuses"] == {"completed": 2}
+    assert summary["usage_by_participant"]["search0"]["calls"] > 0
+
+
+def test_discussion_lines_are_labelled_with_0_based_seats(tmp_path):
+    import re
+    from multi_agent.proxy import MultiAgentProxy
+    from src.server.task import Session
+
+    # broadcast lines are prefixed with the sender's name; ids are 0-based everywhere else
+    assert MultiAgentProxy(Session(), 5).agent_names == [f"Player {i}" for i in range(5)]
+
+    run_dir = str(tmp_path / "run")
+    asyncio.run(run(fake_cfg(num_games=1), run_dir, log_fn=lambda *_: None))
+    labels = [int(n) for e in read_events(game_path(run_dir, 0)) if e["type"] == "llm_call"
+              for n in re.findall(r"Player (\d+) says:", e["data"]["prompt"])]
+    assert labels and set(labels) <= set(range(5)) and 0 in labels
