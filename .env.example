# Copy to .env and fill in (chmod 600 .env). Never commit .env.
# One Boson account per seat. Seat 0 uses _1, seat 1 uses _2, seat 2 uses _3, seat 3 uses _4.
# Seat 4 shares _1. Speech uses _1. A face uploaded on a key is named with BOSON_AVATAR_<seat>
# and must belong to that seat's key (it shows up in GET /v1/avatars for that key only).
BOSON_API_KEY_1=
BOSON_API_KEY_2=
BOSON_API_KEY_3=
BOSON_API_KEY_4=
# BOSON_AVATAR_0=
# BOSON_AVATAR_1=
# BOSON_AVATAR_2=
# BOSON_AVATAR_3=
# BOSON_AVATAR_4=
# LLM players: any OpenAI-compatible endpoint, e.g. a Boson Marketplace key for gpt-6.1-sol
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
